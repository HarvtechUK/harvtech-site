---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

// Only non-draft posts get a page at all, a draft's URL simply doesn't
// exist until the frontmatter flips, so there's nothing to leak.
export async function getStaticPaths() {
  const posts = (await getCollection('writing')).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} - HarvTech`} description={post.data.description}>
  <section class="container-page py-20">
    <a
      href="/writing"
      class="text-text-subtle hover:text-primary mb-8 inline-flex items-center gap-1.5 text-sm font-medium transition"
    >
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M8.5 3L5 7L8.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      All writing
    </a>

    <p class="text-text-subtle mb-3 text-xs font-semibold uppercase tracking-wider">
      {post.data.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
    </p>
    <h1 class="title-display mb-4 hero-gradient max-w-3xl leading-tight">
      {post.data.title}
    </h1>
    <p class="body-muted mb-12 max-w-2xl text-lg">{post.data.description}</p>

    <article class="post-prose max-w-3xl">
      <Content />
    </article>
  </section>
</BaseLayout>

<style>
  /* Minimal markdown prose styles, scoped to writing posts. Mirrors the
     spirit of DocLayout's .doc-prose without importing its chrome. */
  .post-prose :global(h2) {
    color: var(--color-text-primary);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 2.2rem 0 0.8rem;
  }
  .post-prose :global(h3) {
    color: var(--color-text-primary);
    font-size: 1.1rem;
    font-weight: 600;
    margin: 1.8rem 0 0.6rem;
  }
  .post-prose :global(p) {
    color: var(--color-text-muted);
    line-height: 1.75;
    margin: 0 0 1.1rem;
  }
  .post-prose :global(ul),
  .post-prose :global(ol) {
    color: var(--color-text-muted);
    line-height: 1.75;
    margin: 0 0 1.1rem;
    padding-left: 1.4rem;
  }
  .post-prose :global(li) {
    margin: 0.35rem 0;
  }
  .post-prose :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .post-prose :global(code) {
    background: var(--color-bg-3);
    border-radius: 4px;
    font-size: 0.875em;
    padding: 0.1em 0.35em;
  }
  .post-prose :global(pre) {
    background: var(--color-bg-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: 10px;
    margin: 0 0 1.2rem;
    overflow-x: auto;
    padding: 1rem 1.2rem;
  }
  .post-prose :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .post-prose :global(blockquote) {
    border-left: 2px solid var(--color-primary);
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0 0 1.1rem;
    padding-left: 1rem;
  }
</style>
