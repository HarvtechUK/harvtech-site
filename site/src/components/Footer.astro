---
const year = 2026;
---

<footer class="border-border-faintest mt-20 border-t">
  <div class="container-page grid gap-10 py-12 md:grid-cols-3">
    <div>
      <p class="text-text-primary text-lg font-bold tracking-tight">HarvTech</p>
      <p class="body-muted mt-2 max-w-xs text-sm">
        Well-architected Azure landing zones &mdash; secure foundations for
        modern workloads. Available for freelance engagements.
      </p>
    </div>

    <div>
      <p class="eyebrow mb-3">Contact</p>
      <ul class="space-y-2 text-sm">
        <li>
          <a
            href="mailto:alex@harvtech.co.uk"
            class="text-text-hero hover:text-text-primary transition"
          >
            alex@harvtech.co.uk
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/alexander-harvey-39433619"
            class="text-text-hero hover:text-text-primary transition"
            rel="noopener"
            target="_blank"
          >
            LinkedIn
          </a>
        </li>
        <li>
          <a
            href="https://github.com/HarvtechUK/harvtech-site"
            class="text-text-hero hover:text-text-primary transition"
            rel="noopener"
            target="_blank"
          >
            GitHub (this site's source)
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="eyebrow mb-3">Pages</p>
      <ul class="space-y-2 text-sm">
        <li><a href="/approach" class="text-text-hero hover:text-text-primary transition">Approach</a></li>
        <li><a href="/showcase" class="text-text-hero hover:text-text-primary transition">Showcase</a></li>
        <li><a href="/docs" class="text-text-hero hover:text-text-primary transition">Docs</a></li>
        <li><a href="/writing" class="text-text-hero hover:text-text-primary transition">Writing</a></li>
        <li><a href="/cv" class="text-text-hero hover:text-text-primary transition">CV</a></li>
      </ul>
    </div>
  </div>

  <div class="border-border-faintest border-t">
    <div class="container-page text-text-subtle flex flex-col gap-2 py-4 text-xs md:flex-row md:items-center md:justify-between">
      <p>&copy; {year} Alex Harvey. Hosted on Azure, served from this very repo.</p>
      <p>
        Theme tokens derived from
        <a
          href="https://github.com/matt765/Tailcast"
          rel="noopener"
          target="_blank"
          class="hover:text-text-primary underline-offset-2 hover:underline"
        >
          Tailcast
        </a>
        (MIT).
      </p>
    </div>
  </div>
</footer>
