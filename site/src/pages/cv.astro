---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="CV — Alex Harvey"
  description="Senior contract Azure / DevSecOps engineer. UK-based, outside IR35."
>
  <section class="container-page py-20">
    <p class="eyebrow mb-4">CV</p>
    <h1 class="title-display mb-6 hero-gradient max-w-3xl leading-tight">
      Alex Harvey.
    </h1>
    <p class="body-muted mb-10 max-w-2xl text-lg">
      Senior contract DevSecOps engineer. Microsoft Azure, Terraform,
      Entra ID, Front Door + WAF, pipeline security. UK-based, outside
      IR35. Most recent engagements at Tokio Marine Kiln and Brit
      Insurance.
    </p>

    <div class="card p-8">
      <p class="title-card mb-2">Condensed CV coming shortly.</p>
      <p class="body-muted text-sm">
        A web-friendly summary will live here. For the full document,
        please <a
          href="mailto:alex@harvtech.co.uk?subject=CV%20request"
          class="text-secondary hover:text-text-primary underline-offset-2 hover:underline">email me</a>
        — happy to send the latest PDF.
      </p>
    </div>
  </section>
</BaseLayout>
