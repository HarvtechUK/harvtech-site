---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { contact } from '../data/contact';

// The ways to reach us other than the form. A method with nothing set in
// src/data/contact.ts (no booking page yet) is left out of the list rather
// than shown empty. There is no phone number by design.
const methods = [
  contact.bookingUrl && {
    name: 'Pick a time',
    detail: 'Choose a slot in the diary yourself',
    href: contact.bookingUrl,
    external: true,
    icon: 'calendar',
  },
  {
    name: 'Email',
    detail: contact.email,
    href: `mailto:${contact.email}`,
    external: false,
    icon: 'email',
  },
  {
    name: 'LinkedIn',
    detail: contact.linkedinName,
    href: contact.linkedinUrl,
    external: true,
    icon: 'linkedin',
  },
].filter((m) => !!m) as { name: string; detail: string; href: string; external: boolean; icon: string }[];
---

<BaseLayout
  title="Contact - HarvTech"
  description="Request a call with HarvTech about an Azure Health Check, security and compliance remediation, a platform build or migration, or a cost review. UK-based, remote or London."
>
  <section class="container-page pt-12 pb-20 md:pt-16">
    <p class="eyebrow mb-4">Contact</p>
    <h1 class="title-display mb-6 hero-gradient max-w-3xl leading-tight">
      Let&rsquo;s talk about your platform.
    </h1>
    <p class="body-muted max-w-2xl text-lg">
      Whether you want an Azure Health Check, audit findings remediated, a
      landing zone built or a migration scoped - the right place to start is
      a short conversation about where you are and where you need to be.
    </p>
  </section>

  <section class="border-border-faintest border-t">
    <div class="container-page py-20">
      <div class="grid gap-12 lg:grid-cols-[1.15fr_1fr]">

        <!-- Left: the request-a-call form. scroll-mt keeps the heading
             clear of the sticky header when a link jumps straight here;
             the header is three rows tall on a phone, so it needs more. -->
        <div id="request-a-call" class="scroll-mt-52 md:scroll-mt-28">
          <p class="eyebrow mb-3">Request a call</p>
          <h2 class="title-section mb-3">Tell us a little, and we&rsquo;ll arrange a call.</h2>
          <p class="body-muted mb-8 max-w-xl">
            A 30-minute conversation, with no obligation, to understand your
            environment and say honestly whether we are a good fit.
          </p>
          <ContactForm />
        </div>

        <!-- Right: every other way in, and what happens next -->
        <div class="space-y-8">
          <div class="space-y-4">
            <p class="eyebrow mb-3">Or reach us directly</p>
            {
              methods.map((m) => (
                <a
                  href={m.href}
                  rel={m.external ? 'noopener' : undefined}
                  target={m.external ? '_blank' : undefined}
                  class="card group flex items-center gap-5 p-6 transition hover:border-primary/30"
                >
                  <div class="bg-bg-3 text-text-muted flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg">
                    {m.icon === 'email' && (
                      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                        <path d="M2 4.5C2 3.67 2.67 3 3.5 3h11C15.33 3 16 3.67 16 4.5v9c0 .83-.67 1.5-1.5 1.5h-11C2.67 15 2 14.33 2 13.5v-9z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" />
                        <path d="M2 5l7 5 7-5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                    {m.icon === 'linkedin' && (
                      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                        <rect x="2" y="2" width="14" height="14" rx="2" stroke="currentColor" stroke-width="1.25" />
                        <path d="M6 8v5M6 5.5v.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                        <path d="M10 13v-3a1.5 1.5 0 0 1 3 0v3M10 8v5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
                      </svg>
                    )}
                    {m.icon === 'calendar' && (
                      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                        <rect x="2.5" y="3.5" width="13" height="12" rx="1.5" stroke="currentColor" stroke-width="1.25" />
                        <path d="M2.5 7.5h13M6 2v3M12 2v3" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
                      </svg>
                    )}
                  </div>
                  <div class="min-w-0">
                    <p class="text-text-primary text-sm font-semibold group-hover:text-primary transition-colors">{m.name}</p>
                    <p class="body-muted truncate text-sm">{m.detail}</p>
                  </div>
                  <span class="text-text-subtle group-hover:text-primary ml-auto transition-colors text-sm">&rarr;</span>
                </a>
              ))
            }
          </div>

          <div>
            <p class="eyebrow mb-3">What happens next</p>
            <div class="space-y-4">
              {[
                ['01', 'You get in touch', 'The form, an email or a message. A few sentences about your situation is enough to start.'],
                ['02', 'Discovery call', 'A 30-minute conversation to understand your environment and confirm whether we\'re a good fit.'],
                ['03', 'Proposal', 'A written scope and price, usually within two business days of the discovery call.'],
              ].map(([n, heading, body]) => (
                <div class="flex gap-5">
                  <span class="font-display text-2xl font-bold leading-none text-primary opacity-30 w-8 flex-shrink-0">{n}</span>
                  <div>
                    <p class="text-text-primary text-sm font-semibold">{heading}</p>
                    <p class="body-muted mt-0.5 text-sm">{body}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div>
            <p class="eyebrow mb-3">Availability</p>
            <div class="card p-7 space-y-4">
              {[
                ['Location', 'UK-based, remote or London'],
                ['Engagements', 'Azure Health Checks, fixed-scope projects, Well-Architected reviews, ongoing retainers'],
                ['Response time', 'We aim to reply to all enquiries within one business day'],
                ['Currently', 'Accepting new engagements - get in touch to discuss timing and scope'],
              ].map(([label, value]) => (
                <div class="flex gap-4">
                  <span class="text-text-subtle mt-0.5 w-32 flex-shrink-0 text-xs font-semibold uppercase tracking-wider">{label}</span>
                  <span class="text-text-hero text-sm">{value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service links -->
  <section class="border-border-faintest border-t">
    <div class="container-page py-20">
      <p class="eyebrow mb-4">Not sure what you need?</p>
      <h2 class="title-section mb-8 max-w-2xl">
        Start with the health check, or browse the service lines.
      </h2>
      <div class="flex flex-wrap gap-3">
        <a href="/health-check" class="btn-secondary text-sm">Azure Health Check &rarr;</a>
        <a href="/services" class="btn-secondary text-sm">All services &rarr;</a>
        <a href="/approach" class="btn-secondary text-sm">How we work &rarr;</a>
      </div>
    </div>
  </section>
</BaseLayout>
