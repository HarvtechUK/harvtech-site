---
import BaseLayout from './BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  doc: CollectionEntry<'docs'>;
}

const { doc } = Astro.props;

// Fetch siblings in the same category for the sidebar.
const allDocs = await getCollection('docs');
const siblings = allDocs
  .filter(
    (d) =>
      d.data.category === doc.data.category &&
      // Hide other drafts from the sidebar, but always keep the current doc
      // visible — when you're viewing a draft directly, you still want it
      // to appear in its own sidebar so navigation makes sense.
      (d.data.status !== 'draft' || d.id === doc.id),
  )
  .sort((a, b) => a.data.order - b.data.order);

const categoryLabels: Record<string, string> = {
  architecture: 'Architecture',
  decisions: 'Decisions',
  'how-to': 'How-to',
  tools: 'Tools',
};

const here = Astro.url.pathname.replace(/\/$/, '');
const updatedHuman = doc.data.updated.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});

const statusBadge: Record<string, { label: string; cls: string }> = {
  living: { label: 'Living document', cls: 'badge-primary' },
  draft: { label: 'Draft', cls: 'badge-neutral' },
  deprecated: { label: 'Deprecated', cls: 'badge-neutral' },
};
const sb = statusBadge[doc.data.status];
---

<BaseLayout title={`${doc.data.title} — HarvTech`} description={doc.data.description}>
  <div class="container-page py-12 lg:py-16">
    <!-- Breadcrumb -->
    <p class="text-text-muted mb-6 text-sm">
      <a href="/docs" class="hover:text-text-primary">Docs</a>
      <span class="mx-2 text-text-subtle">/</span>
      <a href={`/docs#${doc.data.category}`} class="hover:text-text-primary">
        {categoryLabels[doc.data.category]}
      </a>
    </p>

    <div class="grid gap-10 lg:grid-cols-[240px_1fr]">
      <!-- Sidebar: docs in this category -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <p class="eyebrow mb-3">{categoryLabels[doc.data.category]}</p>
        <ul class="space-y-1">
          {
            siblings.map((s) => {
              const href = `/docs/${s.id}`;
              const active = here === href || here === href.replace(/\/$/, '');
              return (
                <li>
                  <a
                    href={href}
                    class:list={[
                      'block rounded-md px-3 py-1.5 text-sm leading-snug transition',
                      active
                        ? 'text-text-primary bg-bg-3'
                        : 'text-text-muted hover:text-text-primary hover:bg-bg-3/60',
                    ]}
                  >
                    {s.data.title}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </aside>

      <!-- Main content -->
      <article>
        <header class="border-border-faintest mb-8 border-b pb-6">
          <div class="mb-4 flex flex-wrap items-center gap-3">
            <span class={sb.cls}>{sb.label}</span>
            <span class="text-text-subtle text-xs">Updated {updatedHuman}</span>
          </div>
          <h1 class="text-text-primary mb-3 text-3xl font-bold tracking-tight md:text-4xl">
            {doc.data.title}
          </h1>
          {
            doc.data.description && (
              <p class="text-text-muted text-base md:text-lg">{doc.data.description}</p>
            )
          }
        </header>

        <div class="doc-prose">
          <slot />
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* Markdown prose styles. Hand-rolled rather than using
     @tailwindcss/typography to keep deps minimal. Scoped via the
     .doc-prose container so it doesn't bleed into other pages. */

  .doc-prose {
    color: var(--color-text-hero);
    line-height: 1.7;
    font-size: 1rem;
  }

  .doc-prose h2 {
    color: var(--color-text-primary);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 2.5rem 0 1rem;
    border-bottom: 1px solid var(--color-border-faintest);
    padding-bottom: 0.5rem;
  }
  .doc-prose h3 {
    color: var(--color-text-primary);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
  }
  .doc-prose h4 {
    color: var(--color-text-primary);
    font-size: 1rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
  }
  .doc-prose p {
    margin: 1rem 0;
  }
  .doc-prose a {
    color: var(--color-secondary);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-color: rgb(161 163 247 / 0.4);
    transition: color 0.2s;
  }
  .doc-prose a:hover {
    color: var(--color-text-primary);
    text-decoration-color: currentColor;
  }
  .doc-prose strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }
  .doc-prose code:not(pre code) {
    background: var(--color-bg-3);
    color: var(--color-secondary);
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
  }
  .doc-prose pre {
    background: var(--color-bg-2);
    border: 1px solid var(--color-border-faintest);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 1.25rem 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .doc-prose pre code {
    background: transparent;
    color: inherit;
    padding: 0;
    font-size: inherit;
  }
  .doc-prose ul,
  .doc-prose ol {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }
  .doc-prose ul {
    list-style: disc;
  }
  .doc-prose ol {
    list-style: decimal;
  }
  .doc-prose li {
    margin: 0.375rem 0;
  }
  .doc-prose li > p {
    margin: 0.5rem 0;
  }
  .doc-prose blockquote {
    border-left: 3px solid var(--color-primary);
    padding-left: 1rem;
    margin: 1.25rem 0;
    color: var(--color-text-muted);
    font-style: italic;
  }
  .doc-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }
  .doc-prose th,
  .doc-prose td {
    border: 1px solid var(--color-border-faintest);
    padding: 0.625rem 0.875rem;
    text-align: left;
  }
  .doc-prose th {
    background: var(--color-bg-3);
    color: var(--color-text-primary);
    font-weight: 600;
  }
  .doc-prose hr {
    border: none;
    border-top: 1px solid var(--color-border-faintest);
    margin: 2rem 0;
  }
</style>
