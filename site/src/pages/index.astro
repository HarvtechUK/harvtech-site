---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TechMarquee from '../components/TechMarquee.astro';
import Shot from '../components/Shot.astro';
import CallToAction from '../components/CallToAction.astro';
import { services } from '../data/services';
import { callLink } from '../data/contact';
import { counts } from '../data/healthCheck';
import overview from '../assets/health-check/dashboard-overview.png';

const engagementModes = [
  {
    title: 'Greenfield builds',
    eyebrow: 'Starting fresh',
    body: 'Building something new? We start with the right foundations - CAF-aligned landing zone, identity, networking, and security baseline - before the first workload lands. No technical debt inherited, no retrofitting later.',
  },
  {
    title: 'Brownfield modernisation',
    eyebrow: 'Existing platforms',
    body: 'Platform grown organically and showing its age? We assess what you have, identify the security and architectural debt, and deliver a pragmatic remediation roadmap that improves things without breaking production.',
  },
  {
    title: 'Cloud migrations',
    eyebrow: 'On-premises or cross-cloud',
    body: 'Moving from on-premises or another cloud? The CAF Migration Factory gives you a structured, repeatable approach - assess, replicate, migrate, optimise - with documented decisions at every stage.',
  },
];

---

<BaseLayout
  title="HarvTech - Azure security & compliance remediation for London-market insurers"
  description="Azure security and compliance remediation for London-market insurers and regulated financial services firms. Audit findings fixed in Terraform with auditor-ready evidence - Entra ID, PIM, Conditional Access, Key Vault, Defender for Cloud."
>
  <Hero />
  <TechMarquee />

  <!-- The Azure Health Check: the quickest way to find out what needs
       doing, and the natural first step before any of the services below. -->
  <section class="border-border-faintest border-t">
    <div class="container-page py-20">
      <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.15fr]">
        <div>
          <p class="eyebrow mb-4">Azure Health Check</p>
          <h2 class="title-section mb-4">
            Find out what your Azure estate is costing you, and where it is exposed.
          </h2>
          <p class="body-muted mb-6">
            A read-only review of the whole estate for a fixed fee. You get savings
            priced in pounds and security and network findings ranked by severity,
            each with the evidence behind it and a plan for making the change.
          </p>
          <ul class="mb-8 space-y-3">
            {
              [
                `${counts.checks} checks across cost, security and network, in ${counts.areas} areas of Azure`,
                'Read-only: nothing in your tenant is created, changed or deleted',
                'Findings set beside ISO 27001, DORA, IT general controls and Cyber Essentials',
                'The report in your own client portal, as a page and a PDF',
              ].map((item) => (
                <li class="text-text-hero flex gap-3 text-sm leading-relaxed">
                  <span aria-hidden="true" class="text-primary mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-current" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
          <div class="flex flex-wrap gap-3">
            <a href="/health-check" class="btn-primary text-sm">See the health check &rarr;</a>
            <a href={callLink('health-check')} class="btn-secondary text-sm">Request a call</a>
          </div>
        </div>

        <Shot
          src={overview}
          alt="The health check overview for a demonstration estate: a headline monthly saving, security findings by severity and the top ten actions."
          label="Azure estate review - demonstration estate"
          sizes="(min-width: 1024px) 620px, 92vw"
          caption="The overview for our demonstration estate, a made-up insurer."
          fade
        />
      </div>
    </div>
  </section>

  <!-- Engagement modes -->
  <section class="border-border-faintest border-y">
    <div class="container-page py-20">
      <p class="eyebrow mb-4">How we engage</p>
      <h2 class="title-section mb-12 max-w-3xl">
        Greenfield, brownfield, or migration - we&rsquo;ve done all three.
      </h2>

      <div class="grid gap-5 md:grid-cols-3">
        {
          engagementModes.map((m) => (
            <div class="card p-7">
              <p class="eyebrow mb-3">{m.eyebrow}</p>
              <p class="title-card mb-3">{m.title}</p>
              <p class="body-muted text-sm">{m.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Services -->
  <section>
    <div class="container-page py-20">
      <p class="eyebrow mb-4">What we do</p>
      <h2 class="title-section mb-4 max-w-3xl">
        Security and compliance first.
      </h2>
      <p class="body-muted mb-12 max-w-3xl">
        HarvTech is led by Alex Harvey and delivers through a small network
        of vetted senior Azure and identity specialists. Security Hardening
        is the lead service; the broader platform capability behind it
        covers builds, migrations, networking, and cost.
      </p>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s) => (
            <a
              href={`/services/${s.slug}`}
              class="card group block p-6 transition hover:border-primary/30"
            >
              <p class="eyebrow mb-2 text-xs">{s.eyebrow}</p>
              <p class="title-card mb-2 group-hover:text-primary transition-colors">{s.title}</p>
              <p class="body-muted text-sm">{s.summary}</p>
            </a>
          ))
        }
      </div>

      <div class="mt-8 flex gap-3">
        <a href="/services" class="btn-secondary text-sm">
          All services &rarr;
        </a>
        <a href="/approach" class="btn-secondary text-sm">
          How we work &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Credibility -->
  <section class="border-border-faintest border-y">
    <div class="container-page py-20">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr]">
        <div>
          <p class="eyebrow mb-4">Why HarvTech</p>
          <h2 class="title-section mb-4">
            Senior expertise, without the consultancy overhead.
          </h2>
          <p class="body-muted mb-4">
            HarvTech is led by Alex Harvey, 25 years in IT, the
            last seven focused on Microsoft Azure at Lloyd&rsquo;s of
            London market insurers Tokio Marine Kiln and Brit Insurance.
            The work included enterprise landing zones, Entra ID hardening,
            Conditional Access, Defender for Cloud, and Terraform-first
            delivery across regulated environments.
          </p>
          <p class="body-muted">
            You get senior hands-on delivery, not a project manager
            fronting a junior team. Everything we build is documented,
            in code, and handed over with the reasoning intact.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/approach" class="btn-secondary text-sm">
              View background &rarr;
            </a>
            <a href="/showcase" class="btn-secondary text-sm">
              See the showcase &rarr;
            </a>
          </div>
        </div>

        <div class="card p-7">
          <p class="title-card mb-5">Standards we work to</p>
          <ul class="space-y-3">
            {[
              'Microsoft Cloud Adoption Framework (CAF)',
              'Azure Well-Architected Framework (WAF)',
              'CIS Azure Foundations Benchmark',
              'Microsoft Zero Trust security model',
              'DORA, SOX ITGC, FCA, ISO 27001, PCI DSS',
              'Infrastructure as Code - Terraform, azurerm 4.x',
              'GitOps with OIDC-federated CI/CD pipelines',
            ].map((item) => (
              <li class="text-text-hero flex gap-3 text-sm leading-relaxed">
                <span aria-hidden="true" class="text-primary mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-current" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Props are plain text, not HTML, so the apostrophes here are typed
       as real characters rather than &rsquo; entities. -->
  <CallToAction
    title="Let’s talk about your platform."
    body="Whether it’s a failed audit that needs remediating, an upcoming one you need to be ready for, or a platform to build or migrate - get in touch and we’ll scope it together. UK-based, hybrid or fully remote."
  />
</BaseLayout>
