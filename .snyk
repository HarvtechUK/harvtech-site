# Snyk policy file. Same trade-off discipline as `.checkov.yaml` and
# `.trivyignore` — every ignore has a one-line reason and an expiry
# date that forces a periodic re-review rather than letting
# suppressions go stale forever.
#
# Quirk: Snyk IaC's ignore matcher does NOT accept '*' as a wildcard
# across all paths the way Snyk Open Source does. The path key here
# must match the resource-path string Snyk prints in its CLI output:
#
#   [Medium] Storage Account geo-replication disabled
#   Path: resource > azurerm_storage_account[site] > account_replication_type
#   File: main.tf
#
# That whole "resource > ... > attribute" string (without the file
# prefix) is what goes in the path key.

version: v1.0.0
ignore:
  # Storage Account geo-replication disabled — LRS chosen for portfolio
  # cost. Same trade-off documented for Checkov CKV_AZURE_206 and Trivy
  # AZU-0058 (three IaC scanners agreeing on the same finding is itself
  # confidence the rule is right; the trade-off is what we own). The
  # static site is fully recoverable from git, so GRS doubling the
  # storage bill isn't earning its keep. Reassess if we ever serve
  # content that isn't reproducible from source.
  SNYK-CC-AZURE-649:
    - 'resource > azurerm_storage_account[site] > account_replication_type':
        reason: >-
          LRS chosen for portfolio cost. Site content is recoverable
          from git; GRS doubles cost without earning its keep. Matches
          CKV_AZURE_206 / AZU-0058 suppressions in .checkov.yaml and
          .trivyignore.
        expires: '2027-06-01T00:00:00.000Z'
