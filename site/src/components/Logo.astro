---
/**
 * HarvTech brand lockup: original favicon icon (inline SVG so it picks up
 * the teal theme token via currentColor) + "HarvTech" wordmark in Space
 * Grotesk 600.
 *
 * The same icon paths live in /public/favicon.svg (standalone, no CSS).
 * /public/logo.svg is the self-contained vector lockup for external use
 * (README, CV, social cards etc.).
 */

interface Props {
  /** Pixel height of the icon square. */
  size?: number;
  /** Optional extra Tailwind classes on the outer span. */
  class?: string;
}

const { size = 28, class: extraClass = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', extraClass]}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="text-primary flex-shrink-0"
    fill="currentColor"
  >
    <path d="M7.000 4L10.800 4L5.602 20L1.802 20Z" />
    <path d="M11.600 4L15.400 4L10.202 20L6.402 20Z" />
    <path d="M16.200 4L20.000 4L14.802 20L11.002 20Z" />
    <path d="M16.200 4L22.000 4L20.766 7.8L14.966 7.8Z" />
    <path d="M6.993 11.1L11.393 11.1L10.809 12.9L6.409 12.9Z" />
  </svg>
  <span class="logo-wordmark text-text-primary text-lg leading-none">
    HarvTech
  </span>
</span>

<style>
  .logo-wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
</style>
