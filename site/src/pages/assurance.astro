---
import BaseLayout from '../layouts/BaseLayout.astro';

// Placeholder values are marked "[TBC — …]" and listed in the PR that
// introduced this page. Replace them with confirmed values before
// pointing prospects at this page in anger.
const sections = [
  {
    eyebrow: 'Certifications',
    title: 'Cyber Essentials',
    body: 'HarvTech is working towards Cyber Essentials certification. [TBC — replace with certificate number and date once awarded, and state whether Cyber Essentials Plus is in scope.]',
  },
  {
    eyebrow: 'Insurance',
    title: 'Insurances held',
    list: [
      'Professional indemnity insurance — [TBC — cover level and insurer]',
      'Public liability insurance — [TBC — cover level and insurer]',
      'Cyber insurance — [TBC — cover level and insurer]',
      'Confirmation of cover available on request before an engagement begins',
    ],
  },
  {
    eyebrow: 'Data protection',
    title: 'Data processing',
    body: 'HARVTECH LTD is registered in England & Wales and processes personal data in accordance with UK GDPR and the Data Protection Act 2018 — see the privacy policy for detail. Where an engagement involves processing personal data on a client\'s behalf, a data processing agreement is put in place before processing begins. A DPA is available on request.',
  },
  {
    eyebrow: 'Security management',
    title: 'ISO 27001 alignment',
    body: 'HarvTech aligns its working practices to ISO 27001 Annex A controls — access control, cryptography, operations security, supplier relationships, and incident management — proportionate to a specialist consultancy. HarvTech is not ISO 27001 certified; alignment is a working discipline, and we say so plainly rather than implying otherwise.',
  },
  {
    eyebrow: 'Client data',
    title: 'Handling of client data and credentials',
    list: [
      'Client work happens in client-controlled environments wherever possible — your tenant, your repositories, your pipelines.',
      'No standing credentials: access via client-issued named accounts with MFA, and privileged access through PIM/just-in-time elevation where available.',
      'No client data, code, or configuration is reused across engagements, and none is used to train or prompt AI systems without written agreement.',
      'Client materials are removed from HarvTech systems at engagement end, subject to the retention obligations in the Terms of Engagement.',
    ],
  },
  {
    eyebrow: 'Delivery network',
    title: 'Subcontractor vetting',
    body: 'Where delivery involves HarvTech\'s network of vetted senior specialists, each is engaged under written terms that mirror HarvTech\'s client obligations — confidentiality, data protection, and IP assignment — with identity, right-to-work, and reference checks completed before any client access. Specialists receive the minimum access an engagement requires, through the client-controlled routes above, and clients are told who is working on their engagement.',
  },
];
---

<BaseLayout
  title="Assurance — HarvTech"
  description="HarvTech assurance — certifications, insurances, data protection, ISO 27001 alignment, client data handling, and subcontractor vetting for regulated clients."
>
  <section class="container-page py-20">
    <p class="eyebrow mb-4">Assurance</p>
    <h1 class="title-display mb-6 hero-gradient max-w-3xl leading-tight">
      The due-diligence answers, up front.
    </h1>
    <p class="body-muted max-w-2xl text-lg">
      Regulated clients have to ask these questions &mdash; so here are
      the answers before you ask. Anything marked as in progress or
      available on request is exactly that: we&rsquo;d rather be plain
      than impressive.
    </p>
  </section>

  <section class="border-border-faintest border-t">
    <div class="container-page py-16">
      <div class="grid gap-5 md:grid-cols-2">
        {
          sections.map((s) => (
            <div class="card p-8">
              <p class="eyebrow mb-2 text-xs">{s.eyebrow}</p>
              <p class="title-card mb-3">{s.title}</p>
              {s.body && <p class="body-muted text-sm leading-relaxed">{s.body}</p>}
              {s.list && (
                <ul class="space-y-3">
                  {s.list.map((item) => (
                    <li class="flex gap-3 text-sm">
                      <span
                        aria-hidden="true"
                        class="text-primary mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-current"
                      />
                      <span class="body-muted">{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>

      <div class="card mt-5 p-7">
        <p class="body-muted text-sm leading-relaxed">
          Due-diligence questionnaires, confirmation of insurance cover, or
          a DPA &mdash; email{' '}
          <a href="mailto:alex@harvtech.co.uk" class="text-primary hover:underline">
            alex@harvtech.co.uk
          </a>{' '}
          and we&rsquo;ll turn them around quickly. See also the{' '}
          <a href="/privacy" class="text-primary hover:underline">Privacy Policy</a>,{' '}
          <a href="/terms" class="text-primary hover:underline">Terms of Engagement</a>, and{' '}
          <a href="/supplier-code-of-conduct" class="text-primary hover:underline">Supplier Code of Conduct</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
